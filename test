// DVF — PRIX IMMOBILIERS RÉELS
// ═══════════════════════════════════════════════════════════
async function fetchDVF(codeCommune){
  if(!codeCommune)return null;
  try{
    // API DVF Etalab
    const url=`https://apidf-preprod.cerema.fr/indicateurs/dv3f/communes/indicateurs/?code_insee=${codeCommune}&fields=annee,nb_ventes_maison,nb_ventes_appart,prix_m2_median_maison,prix_m2_median_appart,surface_mediane_maison,surface_mediane_appart`;
    const res=await fetch(url);
    if(!res.ok)throw new Error('DVF HTTP '+res.status);
    const data=await res.json();
    if(!data||!data.results||!data.results.length)return null;
    // Prendre l'année la plus récente
    const sorted=data.results.sort((a,b)=>b.annee-a.annee);
    return sorted[0];
  }catch(e){
    // Fallback : API DVF simplifiée
    try{
      const url2=`https://api.gouv.fr/proxy/dvf/api/communes/${codeCommune}/stats`;
      const res2=await fetch(url2);
      if(res2.ok)return await res2.json();
    }catch(e2){}
    return null;
  }
}

