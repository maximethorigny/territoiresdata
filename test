let sugTimeout=null;

document.getElementById('si').addEventListener('keydown',e=>{
  if(e.key==='Enter'){e.preventDefault();hideSugg();doGeocode(document.getElementById('si').value.trim())}
  if(e.key==='Escape')hideSugg();
});
document.getElementById('sbtn').addEventListener('click',()=>{hideSugg();doGeocode(document.getElementById('si').value.trim())});
document.getElementById('si').addEventListener('input',e=>{
  const v=e.target.value;
  document.getElementById('sc').style.display=v?'block':'none';
  clearTimeout(sugTimeout);
  if(v.length>=3)sugTimeout=setTimeout(async()=>{const items=await suggestNominatim(v);showSugg(items)},500);
  else hideSugg();
});
document.getElementById('si').addEventListener('blur',()=>setTimeout(hideSugg,200));
document.getElementById('sc').addEventListener('click',()=>{
  document.getElementById('si').value='';document.getElementById('sc').style.display='none';hideSugg();
  clearMainLayers();clearCompareLayers();document.getElementById('sta').style.display='none';
});
document.getElementById('rad').addEventListener('change',()=>{const v=document.getElementById('si').value.trim();if(v)doGeocode(v)});

document.querySelectorAll('.tab').forEach(t=>t.addEventListener('click',()=>setTab(t.dataset.p)));

document.querySelectorAll('.lcb').forEach(cb=>{
  cb.addEventListener('change',function(){
    const k=this.dataset.l;
    if(k==='iris'){
      if(irisLayer){this.checked?irisLayer.addTo(map):map.removeLayer(irisLayer)}
      if(irisLayer2){this.checked?irisLayer2.addTo(map):map.removeLayer(irisLayer2)}
    }else if(k==='rayon'){
      if(rayonLayer){this.checked?rayonLayer.addTo(map):map.removeLayer(rayonLayer)}
      if(rayonLayer2){this.checked?rayonLayer2.addTo(map):map.removeLayer(rayonLayer2)}
    }else{
      if(layerGroups[k]){this.checked?layerGroups[k].addTo(map):map.removeLayer(layerGroups[k])}
      if(layerGroups[k+'_2']){this.checked?layerGroups[k+'_2'].addTo(map):map.removeLayer(layerGroups[k+'_2'])}
    }
  });
});

