// OVERPASS — POI RÉELS
// ═══════════════════════════════════════════════════════════
async function fetchPOI(key,lat,lng,rayon){
  const cacheKey=key+'_'+lat.toFixed(3)+'_'+lng.toFixed(3)+'_'+rayon;
  if(poiCache[cacheKey])return poiCache[cacheKey];
  const cfg=POI_CFG[key];if(!cfg)return[];
  // Construire requête : node principal + way optionnel pour parcs/stades/universités
  let qParts=cfg.q+'(around:'+rayon+','+lat+','+lng+');';
  if(cfg.extra)qParts+=cfg.extra+'(around:'+rayon+','+lat+','+lng+');';
  const q='[out:json][timeout:20];('+qParts+');out center 50;';
  try{
    const res=await fetch(OVERPASS_URL,{method:'POST',body:q});
    if(!res.ok)return[];
    const d=await res.json();
    const items=(d.elements||[]).map(el=>{
      const lat2=el.lat||(el.center&&el.center.lat);
      const lng2=el.lon||(el.center&&el.center.lon);
      if(!lat2||!lng2)return null;
      return{
        name:(el.tags&&(el.tags.name||el.tags.operator||el.tags.brand))||cfg.l,
        lat:lat2,lng:lng2,tags:el.tags||{}
      };
    }).filter(Boolean);
    poiCache[cacheKey]=items;return items;
  }catch(e){return[]}
}

