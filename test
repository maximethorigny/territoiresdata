
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>GéoStat France</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<style>
*{box-sizing:border-box;margin:0;padding:0;font-family:system-ui,-apple-system,sans-serif}
html,body{height:100%;overflow:hidden}
#app{display:flex;flex-direction:column;height:100vh;background:#fff}
#tb{display:flex;align-items:center;gap:8px;padding:7px 14px;border-bottom:1px solid #e5e7eb;background:#fff;z-index:1000;flex-wrap:wrap}
#tb h1{font-size:14px;font-weight:700;color:#111;white-space:nowrap}
.sep{width:1px;height:20px;background:#e5e7eb;flex-shrink:0}
#sw{position:relative;flex:1;min-width:220px;max-width:380px}
#si{width:100%;font-size:13px;padding:6px 68px 6px 28px;border:1px solid #d1d5db;border-radius:8px;background:#fff;color:#111;outline:none;transition:border-color .15s}
#si:focus{border-color:#3b82f6;box-shadow:0 0 0 3px rgba(59,130,246,.12)}
.sico{position:absolute;left:8px;top:50%;transform:translateY(-50%);color:#9ca3af;font-size:14px;pointer-events:none}
#sc{position:absolute;right:44px;top:50%;transform:translateY(-50%);color:#9ca3af;background:none;border:none;cursor:pointer;font-size:13px;padding:0;display:none}
#sbtn{position:absolute;right:4px;top:50%;transform:translateY(-50%);background:#3b82f6;color:#fff;border:none;border-radius:6px;padding:4px 10px;font-size:12px;cursor:pointer;font-weight:600}
#sbtn:hover{background:#2563eb}
#sbtn:disabled{background:#9ca3af;cursor:not-allowed}
#sugg{position:absolute;top:calc(100% + 4px);left:0;right:0;background:#fff;border:1px solid #e5e7eb;border-radius:8px;z-index:600;display:none;max-height:240px;overflow-y:auto;box-shadow:0 8px 24px rgba(0,0,0,.12)}
.sug{padding:8px 12px;font-size:12px;cursor:pointer;color:#111;border-bottom:1px solid #f3f4f6}
.sug:last-child{border-bottom:none}
.sug:hover{background:#f9fafb}
.sug-s{font-size:10px;color:#6b7280;margin-top:1px}
select,#tbbtns button{font-size:11px;padding:4px 8px;border:1px solid #d1d5db;border-radius:6px;background:#fff;color:#111;cursor:pointer}
#tbbtns{display:flex;gap:4px}
#tbbtns button:hover{background:#f3f4f6}
#tbbtns button.active{background:#3b82f6;color:#fff;border-color:#3b82f6}
#main{display:flex;flex:1;overflow:hidden}
#sb{width:256px;flex-shrink:0;border-right:1px solid #e5e7eb;display:flex;flex-direction:column;overflow:hidden;background:#fff}
#ly{padding:8px 10px;border-bottom:1px solid #e5e7eb;overflow-y:auto;max-height:190px}
.lt{font-size:10px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.6px;margin-bottom:5px}
.lg2{margin-bottom:5px}
.lgt{font-size:10px;color:#9ca3af;font-weight:600;margin-bottom:2px}
.lr{display:flex;align-items:center;padding:1px 0}
.lr label{display:flex;align-items:center;gap:5px;cursor:pointer;font-size:11px;color:#374151}
.dot{width:9px;height:9px;border-radius:50%;flex-shrink:0}
.sq{width:9px;height:9px;border-radius:2px;flex-shrink:0;opacity:.7}
input[type=checkbox]{width:11px;height:11px;cursor:pointer;flex-shrink:0;accent-color:#3b82f6}
#tabs{display:flex;border-bottom:1px solid #e5e7eb;flex-shrink:0;overflow-x:auto}
.tab{flex:1;min-width:32px;padding:7px 2px;font-size:10px;text-align:center;cursor:pointer;color:#6b7280;border-bottom:2px solid transparent;background:none;border-top:none;border-left:none;border-right:none;white-space:nowrap}
.tab.on{color:#3b82f6;border-bottom-color:#3b82f6;font-weight:700}
#pb{flex:1;overflow-y:auto;padding:10px}
.ps{display:none}.ps.on{display:block}
.sl{font-size:10px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.4px;margin:9px 0 4px}
.kv{display:flex;justify-content:space-between;align-items:baseline;padding:3px 0;border-bottom:1px solid #f3f4f6;font-size:11px;gap:6px}
.kv:last-child{border-bottom:none}
.kl{color:#6b7280;flex-shrink:0}
.kv2{font-weight:600;color:#111;text-align:right}
.acc{color:#3b82f6!important}.grn{color:#10b981!important}.red{color:#ef4444!important}
.nc{background:#f9fafb;border-radius:8px;padding:8px 10px;margin-bottom:7px;border:1px solid #e5e7eb}
.nc .big{font-size:13px;font-weight:700;color:#111}
.nc .sm{font-size:10px;color:#6b7280;margin-top:2px}
.em{font-size:11px;color:#9ca3af;padding:14px 0;text-align:center;line-height:1.8}
.pi{padding:5px 0;border-bottom:1px solid #f3f4f6;font-size:11px}
.pi:last-child{border-bottom:none}
.pn{font-weight:600;color:#111}
.pm{color:#6b7280;font-size:10px;margin-top:1px}
.pe{display:inline-block;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700;margin-left:3px;background:#eff6ff;color:#3b82f6}
.bbar{height:5px;border-radius:3px;background:#f3f4f6;margin:3px 0 6px;overflow:hidden}
.bf{height:100%;border-radius:3px}
.note{font-size:10px;color:#6b7280;padding:6px 8px;background:#f9fafb;border-radius:6px;margin-top:7px;line-height:1.6;border:1px solid #f3f4f6}
.aib{display:inline-flex;align-items:center;gap:3px;padding:2px 7px;border-radius:4px;font-size:9px;font-weight:700;background:#eff6ff;color:#3b82f6;margin-bottom:6px}
.rib{display:inline-flex;align-items:center;gap:3px;padding:2px 7px;border-radius:4px;font-size:9px;font-weight:700;background:#f0fdf4;color:#10b981;margin-bottom:6px}
.spn{display:inline-block;width:11px;height:11px;border:2px solid #e5e7eb;border-top-color:#3b82f6;border-radius:50%;animation:spin .6s linear infinite;vertical-align:middle;margin-right:5px}
@keyframes spin{to{transform:rotate(360deg)}}
.ldg{font-size:11px;color:#6b7280;padding:14px 0;text-align:center}
/* Historique */
#hist-panel{position:absolute;top:44px;right:0;width:280px;background:#fff;border:1px solid #e5e7eb;border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,.12);z-index:900;display:none;max-height:320px;overflow-y:auto}
.hist-item{padding:8px 12px;border-bottom:1px solid #f3f4f6;cursor:pointer;font-size:12px}
.hist-item:hover{background:#f9fafb}
.hist-item .hi-addr{font-weight:600;color:#111}
.hist-item .hi-date{font-size:10px;color:#9ca3af;margin-top:1px}
/* Comparaison */
#cmp-bar{display:none;background:#fffbeb;border-bottom:1px solid #fde68a;padding:6px 14px;font-size:12px;color:#92400e;align-items:center;gap:8px}
#cmp-bar button{font-size:11px;padding:3px 8px;border-radius:5px;border:1px solid #f59e0b;background:#fff;color:#92400e;cursor:pointer}
/* Map */
#mw{flex:1;position:relative;overflow:hidden}
#mel{width:100%;height:100%}
#sta{position:absolute;bottom:12px;left:50%;transform:translateX(-50%);background:rgba(255,255,255,.96);border:1px solid #e5e7eb;border-radius:8px;padding:6px 16px;font-size:12px;color:#374151;display:none;white-space:nowrap;z-index:1000;pointer-events:none;box-shadow:0 4px 12px rgba(0,0,0,.1)}
/* Comparaison overlay */
#cmp-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:2000;align-items:center;justify-content:center}
#cmp-box{background:#fff;border-radius:12px;width:90%;max-width:760px;max-height:85vh;overflow-y:auto;padding:20px}
#cmp-box h2{font-size:15px;font-weight:700;margin-bottom:14px;color:#111}
.cmp-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.cmp-col{background:#f9fafb;border-radius:8px;padding:12px;border:1px solid #e5e7eb}
.cmp-col h3{font-size:12px;font-weight:700;color:#3b82f6;margin-bottom:8px}
.cmp-kv{display:flex;justify-content:space-between;padding:3px 0;font-size:11px;border-bottom:1px solid #f3f4f6}
.cmp-kv:last-child{border-bottom:none}
.cmp-kl{color:#6b7280}
.cmp-kv2{font-weight:600;color:#111}
.better{color:#10b981!important}
.worse{color:#ef4444!important}
</style>
</head>
<body>
<div id="app">

<!-- Toolbar -->
<div id="tb">
  <h1>🗺 GéoStat France</h1>
  <div class="sep"></div>
  <div id="sw">
    <span class="sico">🔍</span>
    <input type="text" id="si" placeholder="Adresse, ville, code postal…" autocomplete="off"/>
    <button id="sc" title="Effacer">✕</button>
    <button id="sbtn">Chercher</button>
    <div id="sugg"></div>
  </div>
  <div class="sep"></div>
  <label style="font-size:11px;color:#6b7280">Rayon</label>
  <select id="rad">
    <option value="300">300 m</option>
    <option value="500" selected>500 m</option>
    <option value="1000">1 km</option>
    <option value="2000">2 km</option>
  </select>
  <div class="sep"></div>
  <div id="tbbtns" style="position:relative">
    <button id="btn-hist" title="Historique des recherches">🕐 Historique</button>
    <button id="btn-cmp" title="Comparer deux adresses">⚖️ Comparer</button>
    <button id="btn-pdf" title="Exporter en PDF">📄 PDF</button>
    <div id="hist-panel"></div>
  </div>
</div>

<!-- Barre comparaison -->
<div id="cmp-bar">
  <span id="cmp-msg">Mode comparaison : recherchez une 2e adresse</span>
  <button id="btn-cmp-cancel">Annuler</button>
  <button id="btn-cmp-show" style="display:none;background:#f59e0b;color:#fff;border-color:#d97706">Voir la comparaison</button>
</div>

<div id="main">
<div id="sb">
  <div id="ly">
    <div class="lt">Couches</div>
    <div class="lg2"><div class="lgt">Transports</div>
      <div class="lr"><label><input type="checkbox" class="lcb" data-l="bus" checked/><span class="dot" style="background:#2980b9"></span>Bus / tram</label></div>
      <div class="lr"><label><input type="checkbox" class="lcb" data-l="metro" checked/><span class="dot" style="background:#8e44ad"></span>Métro / RER</label></div>
      <div class="lr"><label><input type="checkbox" class="lcb" data-l="train"/><span class="dot" style="background:#c0392b"></span>Gares</label></div>
    </div>
    <div class="lg2"><div class="lgt">Commerces</div>
      <div class="lr"><label><input type="checkbox" class="lcb" data-l="supermarket" checked/><span class="dot" style="background:#27ae60"></span>Supermarchés</label></div>
      <div class="lr"><label><input type="checkbox" class="lcb" data-l="pharmacy" checked/><span class="dot" style="background:#e74c3c"></span>Pharmacies</label></div>
      <div class="lr"><label><input type="checkbox" class="lcb" data-l="bakery"/><span class="dot" style="background:#e67e22"></span>Boulangeries</label></div>
      <div class="lr"><label><input type="checkbox" class="lcb" data-l="bank"/><span class="dot" style="background:#2c3e50"></span>Banques</label></div>
      <div class="lr"><label><input type="checkbox" class="lcb" data-l="post_office"/><span class="dot" style="background:#f39c12"></span>Bureaux de poste</label></div>
      <div class="lr"><label><input type="checkbox" class="lcb" data-l="cafe"/><span class="dot" style="background:#795548"></span>Cafés</label></div>
      <div class="lr"><label><input type="checkbox" class="lcb" data-l="bar"/><span class="dot" style="background:#6d4c41"></span>Bars</label></div>
      <div class="lr"><label><input type="checkbox" class="lcb" data-l="fast_food"/><span class="dot" style="background:#ff5722"></span>Fast food</label></div>
    </div>
    <div class="lg2"><div class="lgt">Équipements</div>
      <div class="lr"><label><input type="checkbox" class="lcb" data-l="doctor" checked/><span class="dot" style="background:#00bcd4"></span>Médecins</label></div>
      <div class="lr"><label><input type="checkbox" class="lcb" data-l="park"/><span class="dot" style="background:#4caf50"></span>Parcs</label></div>
      <div class="lr"><label><input type="checkbox" class="lcb" data-l="theatre"/><span class="dot" style="background:#9c27b0"></span>Théâtres</label></div>
      <div class="lr"><label><input type="checkbox" class="lcb" data-l="stadium"/><span class="dot" style="background:#ff9800"></span>Stades</label></div>
    </div>
    <div class="lg2"><div class="lgt">Éducation</div>
      <div class="lr"><label><input type="checkbox" class="lcb" data-l="lycee" checked/><span class="dot" style="background:#1565c0"></span>Lycées</label></div>
      <div class="lr"><label><input type="checkbox" class="lcb" data-l="sup" checked/><span class="dot" style="background:#6a1b9a"></span>Enseignement supérieur</label></div>
    </div>
    <div class="lg2"><div class="lgt">Zones</div>
      <div class="lr"><label><input type="checkbox" class="lcb" data-l="iris" checked/><span class="sq" style="background:#3b82f6"></span>Périmètre IRIS</label></div>
      <div class="lr"><label><input type="checkbox" class="lcb" data-l="rayon" checked/><span class="sq" style="background:#ef4444;border-radius:50%"></span>Rayon de recherche</label></div>
    </div>
  </div>
  <div id="tabs">
    <button class="tab on" data-p="stats">Stats</button>
    <button class="tab" data-p="iris">IRIS</button>
    <button class="tab" data-p="immo">Immo</button>
    <button class="tab" data-p="transport">Transp.</button>
    <button class="tab" data-p="commerce">Comm.</button>
    <button class="tab" data-p="educ">Éduc.</button>
    <button class="tab" data-p="equip">Équip.</button>
  </div>
  <div id="pb">
    <div id="panel-stats" class="ps on"><div class="em">Entrez une adresse<br>pour afficher les données</div></div>
    <div id="panel-iris" class="ps"><div class="em">Entrez une adresse<br>pour les données IRIS INSEE</div></div>
    <div id="panel-immo" class="ps"><div class="em">Entrez une adresse<br>pour les données immobilières</div></div>
    <div id="panel-transport" class="ps"><div class="em">Entrez une adresse<br>pour les transports proches</div></div>
    <div id="panel-commerce" class="ps"><div class="em">Entrez une adresse<br>pour les commerces proches</div></div>
    <div id="panel-educ" class="ps"><div class="em">Entrez une adresse<br>pour les établissements</div></div>
    <div id="panel-equip" class="ps"><div class="em">Entrez une adresse<br>pour les équipements</div></div>
  </div>
</div>
<div id="mw">
  <div id="mel"></div>
  <div id="sta"></div>
</div>
</div>

<!-- Overlay comparaison -->
<div id="cmp-overlay">
  <div id="cmp-box">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
      <h2>⚖️ Comparaison des deux adresses</h2>
      <button onclick="document.getElementById('cmp-overlay').style.display='none'" style="background:none;border:none;font-size:18px;cursor:pointer;color:#6b7280">✕</button>
    </div>
    <div id="cmp-content"></div>
  </div>
</div>

</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
// ═══════════════════════════════════════════════════════════
// CONFIG OVERPASS
// ═══════════════════════════════════════════════════════════
const OVERPASS_URL = 'https://overpass-api.de/api/interpreter';
const POI_CFG = {
  bus:        {e:'🚌',c:'#2980b9',q:'node["highway"="bus_stop"]',l:'Bus/tram',node:true},
  metro:      {e:'🚇',c:'#8e44ad',q:'node["railway"~"station|subway_entrance"]',l:'Métro/RER',node:true},
  train:      {e:'🚂',c:'#c0392b',q:'node["railway"="station"]',l:'Gare',node:true},
  supermarket:{e:'🛒',c:'#27ae60',q:'node["shop"~"supermarket|convenience|grocery"]',l:'Supermarché',node:true},
  pharmacy:   {e:'💊',c:'#e74c3c',q:'node["amenity"="pharmacy"]',l:'Pharmacie',node:true},
  bakery:     {e:'🥖',c:'#e67e22',q:'node["shop"="bakery"]',l:'Boulangerie',node:true},
  bank:       {e:'🏦',c:'#2c3e50',q:'node["amenity"="bank"]',l:'Banque',node:true},
  post_office:{e:'📮',c:'#f39c12',q:'node["amenity"="post_office"]',l:'Poste',node:true},
  cafe:       {e:'☕',c:'#795548',q:'node["amenity"="cafe"]',l:'Café',node:true},
  bar:        {e:'🍺',c:'#6d4c41',q:'node["amenity"="bar"]',l:'Bar',node:true},
  fast_food:  {e:'🍔',c:'#ff5722',q:'node["amenity"="fast_food"]',l:'Fast food',node:true},
  doctor:     {e:'🩺',c:'#00bcd4',q:'node["amenity"~"doctors|clinic|hospital"]',l:'Médecin',node:true},
  park:       {e:'🌳',c:'#4caf50',q:'node["leisure"="park"]',l:'Parc',node:true,extra:'way["leisure"="park"]'},
  theatre:    {e:'🎭',c:'#9c27b0',q:'node["amenity"~"theatre|cinema"]',l:'Théâtre/Cinéma',node:true},
  stadium:    {e:'🏟️',c:'#ff9800',q:'node["leisure"~"stadium|sports_centre"]',l:'Stade',node:true,extra:'way["leisure"~"stadium|sports_centre"]'},
  lycee:      {e:'🏫',c:'#1565c0',q:'node["amenity"="school"]',l:'École/Lycée',node:true},
  sup:        {e:'🎓',c:'#6a1b9a',q:'node["amenity"~"university|college"]',l:'Supérieur',node:true,extra:'way["amenity"~"university|college"]'},
};

// ═══════════════════════════════════════════════════════════
// ÉTAT GLOBAL
// ═══════════════════════════════════════════════════════════
let map, layerGroups={}, irisLayer=null, rayonLayer=null, pinMarker=null;
let pinMarker2=null, irisLayer2=null, rayonLayer2=null;
let currentGeo=null, currentIRIS=null, currentEst=null, currentRayon=500;
let compareGeo=null, compareIRIS=null, compareEst=null;
let compareMode=false;
let history=JSON.parse(localStorage.getItem('geohist')||'[]');
let poiCache={};

// ═══════════════════════════════════════════════════════════
// UTILITAIRES UI
// ═══════════════════════════════════════════════════════════
function kv(l,v,c=''){return`<div class="kv"><span class="kl">${l}</span><span class="kv2 ${c}">${v}</span></div>`}
function bar(p,col='#3b82f6'){return`<div class="bbar"><div class="bf" style="width:${Math.min(100,Math.max(0,p))}%;background:${col}"></div></div>`}
function showSta(m,t=4000){const e=document.getElementById('sta');e.textContent=m;e.style.display='block';if(t)setTimeout(()=>e.style.display='none',t)}
function setTab(p){document.querySelectorAll('.tab').forEach(t=>t.classList.remove('on'));document.querySelectorAll('.ps').forEach(s=>s.classList.remove('on'));document.querySelector(`.tab[data-p="${p}"]`).classList.add('on');document.getElementById('panel-'+p).classList.add('on')}
function ldPanel(id,m){document.getElementById(id).innerHTML=`<div class="ldg"><span class="spn"></span>${m}</div>`}
function hideSugg(){document.getElementById('sugg').style.display='none'}
function showSugg(items){
  const box=document.getElementById('sugg');box.innerHTML='';
  items.forEach(item=>{
    const d=document.createElement('div');d.className='sug';
    d.innerHTML=`<div>${item.display}</div><div class="sug-s">${item.lat.toFixed(4)}°N · ${item.lng.toFixed(4)}°E</div>`;
    d.addEventListener('mousedown',e=>{e.preventDefault();document.getElementById('si').value=item.display;hideSugg();doGeocode(item.display,item.lat,item.lng)});
    box.appendChild(d);
  });
  box.style.display=items.length?'block':'none';
}

// ═══════════════════════════════════════════════════════════
// HISTORIQUE
// ═══════════════════════════════════════════════════════════
function saveHistory(geo){
  history=history.filter(h=>h.display!==geo.display);
  history.unshift({display:geo.display,commune:geo.commune,dept:geo.dept,lat:geo.lat,lng:geo.lng,date:new Date().toLocaleDateString('fr-FR')});
  history=history.slice(0,20);
  localStorage.setItem('geohist',JSON.stringify(history));
  renderHistory();
}
function renderHistory(){
  const panel=document.getElementById('hist-panel');
  if(!history.length){panel.innerHTML='<div class="em">Aucun historique</div>';return}
  panel.innerHTML=history.map((h,i)=>`
    <div class="hist-item" onclick="loadFromHistory(${i})">
      <div class="hi-addr">${h.display}</div>
      <div class="hi-date">${h.commune||''} · ${h.date}</div>
    </div>`).join('');
}
function loadFromHistory(i){
  const h=history[i];
  document.getElementById('si').value=h.display;
  document.getElementById('hist-panel').style.display='none';
  doGeocode(h.display,h.lat,h.lng);
}
renderHistory();

// ═══════════════════════════════════════════════════════════
// NOMINATIM
// ═══════════════════════════════════════════════════════════
async function geocodeNominatim(query){
  const url='https://nominatim.openstreetmap.org/search?format=json&q='+encodeURIComponent(query)+'&countrycodes=fr&limit=1&addressdetails=1&accept-language=fr';
  const res=await fetch(url,{headers:{'User-Agent':'GeoStatFrance/1.0'}});
  if(!res.ok)throw new Error('Nominatim HTTP '+res.status);
  const data=await res.json();
  if(!data||!data.length)return{found:false};
  const r=data[0];const a=r.address||{};
  const pc=a.postcode||'';
  let dept=pc.slice(0,2);
  if(dept==='20') dept=parseFloat(r.lon)>9?'2B':'2A';
  return{found:true,lat:parseFloat(r.lat),lng:parseFloat(r.lon),display:r.display_name.split(',').slice(0,3).join(','),rue:(a.house_number?a.house_number+' ':'')+(a.road||''),commune:a.city||a.town||a.village||a.municipality||'',codePostal:pc,dept,region:a.state||'',population:0,densite:0,superficie:0};
}

async function suggestNominatim(query){
  const url='https://nominatim.openstreetmap.org/search?format=json&q='+encodeURIComponent(query)+'&countrycodes=fr&limit=6&accept-language=fr';
  const res=await fetch(url,{headers:{'User-Agent':'GeoStatFrance/1.0'}});
  if(!res.ok)return[];
  const data=await res.json();
  return data.map(r=>({display:r.display_name.split(',').slice(0,3).join(',').trim(),lat:parseFloat(r.lat),lng:parseFloat(r.lon)}));
