  await renderPOIPanel('commerce',['supermarket','pharmacy','bakery','bank','post_office','cafe','bar','fast_food'],geo.lat,geo.lng,rayon);
  await renderPOIPanel('educ',['lycee','sup'],geo.lat,geo.lng,rayon,true);
  await renderPOIPanel('equip',['doctor','park','theatre','stadium'],geo.lat,geo.lng,rayon);
}

async function renderPOIPanel(panelId,keys,lat,lng,rayon,showEff=false){
  ldPanel('panel-'+panelId,'Chargement POI réels (OpenStreetMap)…');
  let html='';
  for(const key of keys){
    const cfg=POI_CFG[key];
    const items=await fetchPOI(key,lat,lng,rayon);
    if(!items.length)continue;
    html+=`<div class="sl">${cfg.e} ${cfg.l} (${items.length})</div>`;
    items.slice(0,6).forEach(item=>{
      const oh=item.tags.opening_hours||'';
      const phone=item.tags.phone||item.tags['contact:phone']||'';
      const addr=[item.tags['addr:housenumber'],item.tags['addr:street']].filter(Boolean).join(' ');
      html+=`<div class="pi">
        <div class="pn">${item.name}${oh==='24/7'?'<span class="pe">24/7</span>':''}</div>
        ${addr?`<div class="pm">${addr}</div>`:''}
        ${oh&&oh!=='24/7'?`<div class="pm">🕐 ${oh.slice(0,45)}</div>`:''}
        ${phone?`<div class="pm">📞 ${phone}</div>`:''}
      </div>`;
    });
    if(items.length>6)html+=`<div style="font-size:10px;color:#9ca3af;padding:2px 0">+${items.length-6} autres dans le rayon</div>`;
  }
  html+=`<div class="note">Source : OpenStreetMap via Overpass API</div>`;
  document.getElementById('panel-'+panelId).innerHTML=html||`<div class="em">Aucun résultat dans ce rayon</div>`;
}

