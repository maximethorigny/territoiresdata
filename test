// COMPARAISON
// ═══════════════════════════════════════════════════════════
function showComparison(){
  if(!currentGeo||!compareGeo)return;
  const a=currentEst,b=compareEst;
  const ga=currentGeo,gb=compareGeo;

  function cmpKV(label,va,vb,higherIsBetter=true){
    const na=parseFloat(String(va).replace(/[^0-9.-]/g,''));
    const nb=parseFloat(String(vb).replace(/[^0-9.-]/g,''));
    let clsA='',clsB='';
    if(!isNaN(na)&&!isNaN(nb)&&na!==nb){
      if(higherIsBetter){clsA=na>nb?'better':'worse';clsB=nb>na?'better':'worse';}
      else{clsA=na<nb?'better':'worse';clsB=nb<na?'better':'worse';}
    }
    return`<div class="cmp-kv"><span class="cmp-kl">${label}</span><span class="cmp-kv2 ${clsA}">${va}</span><span class="cmp-kv2 ${clsB}">${vb}</span></div>`;
  }

  document.getElementById('cmp-content').innerHTML=`
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;font-size:11px;margin-bottom:10px">
      <div style="background:#eff6ff;padding:8px;border-radius:6px;font-weight:700;color:#3b82f6">📍 A — ${ga.commune||ga.display}</div>
      <div style="background:#fffbeb;padding:8px;border-radius:6px;font-weight:700;color:#f59e0b;margin-left:8px">📍 B — ${gb.commune||gb.display}</div>
    </div>
    <div style="font-size:10px;color:#6b7280;margin-bottom:10px">🟢 Vert = meilleur · 🔴 Rouge = moins bon</div>

    <div style="font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.4px;margin:10px 0 5px">Localisation</div>
    <div style="display:grid;grid-template-columns:auto 1fr 1fr;gap:0">
      ${['Commune','Département','Population','Densité'].map((l,i)=>{
        const vals=[
          [ga.commune||'—',gb.commune||'—',false],
          [ga.dept,gb.dept,false],
          [ga.population?(ga.population/1000).toFixed(0)+'k':'—',gb.population?(gb.population/1000).toFixed(0)+'k':'—',true],
          [ga.densite?ga.densite.toLocaleString('fr-FR'):'—',gb.densite?gb.densite.toLocaleString('fr-FR'):'—',false],
        ][i];
        return cmpKV(l,vals[0],vals[1],vals[2]);
      }).join('')}
    </div>

    <div style="font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.4px;margin:10px 0 5px">Logement IRIS</div>
    <div style="display:grid;grid-template-columns:auto 1fr 1fr;gap:0">
      ${cmpKV('Propriétaires',a.pctProp+'%',b.pctProp+'%',true)}
      ${cmpKV('HLM',a.pctHLM+'%',b.pctHLM+'%',false)}
      ${cmpKV('Maisons',a.pctMaison+'%',b.pctMaison+'%',false)}
      ${cmpKV('Sans voiture',a.pctSV+'%',b.pctSV+'%',false)}
      ${cmpKV('Revenu médian',a.rev.toLocaleString('fr-FR')+'€',b.rev.toLocaleString('fr-FR')+'€',true)}
      ${cmpKV('Chômage',a.txCho+'%',b.txCho+'%',false)}
      ${cmpKV('Âge médian',a.ageMed+' ans',b.ageMed+' ans',false)}
    </div>

    <div style="font-size:11px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.4px;margin:10px 0 5px">Immobilier</div>
    <div style="display:grid;grid-template-columns:auto 1fr 1fr;gap:0">
      ${cmpKV('Prix appart. /m²',a.prixA.toLocaleString('fr-FR')+'€',b.prixA.toLocaleString('fr-FR')+'€',false)}
      ${cmpKV('Prix maison /m²',a.prixM.toLocaleString('fr-FR')+'€',b.prixM.toLocaleString('fr-FR')+'€',false)}
      ${cmpKV('Loyer appart.',a.loyer+'€/m²',b.loyer+'€/m²',false)}
      ${cmpKV('Tension locative',a.tension,b.tension,false)}
      ${cmpKV('Évol. 1 an',(a.ev1>=0?'+':'')+a.ev1+'%',(b.ev1>=0?'+':'')+b.ev1+'%',true)}
    </div>`;

  document.getElementById('cmp-overlay').style.display='flex';
}

// ═══════════════════════════════════════════════════════════
// GEOCODAGE PRINCIPAL
// ═══════════════════════════════════════════════════════════
async function doGeocode(query,knownLat,knownLng){
  if(!query.trim())return;
  const btn=document.getElementById('sbtn');
  btn.textContent='⏳';btn.disabled=true;
  showSta('Géocodage en cours…',0);
  ['stats','iris','immo','transport','commerce','educ','equip'].forEach(p=>ldPanel('panel-'+p,'Chargement…'));
  setTab('stats');

  try{
    let geo;
    if(knownLat&&knownLng){
      geo={found:true,lat:knownLat,lng:knownLng,display:query,commune:query.split(',')[0].trim(),codePostal:'',dept:'00',region:'',population:0,densite:0,superficie:0};
      try{const det=await geocodeNominatim(query);if(det.found)geo={...det,lat:knownLat,lng:knownLng}}catch(e){}
    }else{
      geo=await geocodeNominatim(query);
    }

    if(!geo.found){
      showSta('Adresse introuvable',5000);
      ['stats','iris','immo','transport','commerce','educ','equip'].forEach(p=>
        document.getElementById('panel-'+p).innerHTML='<div class="em">Adresse introuvable.<br>Exemples :<br>"15 rue de Rivoli Paris"<br>"Place Bellecour Lyon"</div>');
      return;
    }

    geo=await enrichCommune(geo);
    const irisData=geo.codeCommune?await getIRIS(geo.lat,geo.lng,geo.codeCommune):null;
    const rayon=parseInt(document.getElementById('rad').value);

    // Mode comparaison
    if(compareMode&&currentGeo){
      compareGeo=geo;compareIRIS=irisData;compareEst=estimate(geo.dept,geo.densite||0);
      clearCompareLayers();
      await drawLayers(geo.lat,geo.lng,rayon,irisData,geo.display||query,true);
      document.getElementById('cmp-msg').textContent='B : '+geo.display;
      document.getElementById('btn-cmp-show').style.display='inline-block';
      showSta('📍 B : '+(geo.display||query),4000);
      btn.textContent='Chercher';btn.disabled=false;
      return;
    }

    // Recherche principale
    clearMainLayers();
    currentGeo=geo;currentIRIS=irisData;
    map.setView([geo.lat,geo.lng],15,{animate:true});

    // Données réelles en parallèle
    const [_,dvfData,loyerData]=await Promise.all([
      drawLayers(geo.lat,geo.lng,rayon,irisData,geo.display||query,false),
      geo.codeCommune?fetchDVF(geo.codeCommune):Promise.resolve(null),
      geo.codePostal?fetchLoyers(geo.codePostal,geo.commune):Promise.resolve(null),
    ]);

    await renderPanels(geo,irisData,dvfData,loyerData,rayon);
    saveHistory(geo);
    showSta('📍 '+(geo.display||query),5000);

  }catch(e){
    showSta('Erreur : '+e.message,6000);
    document.getElementById('panel-stats').innerHTML=`<div class="em">Erreur.<br><small>${e.message}</small></div>`;
  }finally{
    btn.textContent='Chercher';btn.disabled=false;
  }
}

