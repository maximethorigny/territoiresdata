async function drawLayers(lat,lng,rayon,irisData,display,isCompare=false){
  const pinColor=isCompare?'#f59e0b':'#ef4444';
  const irisColor=isCompare?'#f59e0b':'#3b82f6';
  const suffix=isCompare?'_2':'';

  const pin=L.marker([lat,lng],{icon:L.divIcon({
    html:`<div style="width:18px;height:18px;background:${pinColor};border-radius:50%;border:3px solid #fff;box-shadow:0 0 0 3px ${pinColor}44"></div>`,
    className:'',iconSize:[18,18],iconAnchor:[9,9]
  })}).bindPopup(`<b>${isCompare?'B':'A'}: ${display}</b>`).addTo(map);

  if(isCompare) pinMarker2=pin; else pinMarker=pin;

  // IRIS
  let iL;
  if(irisData&&irisData.contour){
    iL=L.geoJSON(irisData.contour,{style:{color:irisColor,weight:2,dashArray:'8,4',fillColor:irisColor,fillOpacity:.08}})
      .bindTooltip((isCompare?'B — ':'A — ')+'IRIS : '+(irisData.nom||''),{direction:'top'}).addTo(map);
  }else{
    const w=0.007+Math.random()*.005,h=0.005+Math.random()*.004;
    const pts=[[lat-h,lng-w],[lat-h,lng+w],[lat+h,lng+w],[lat+h,lng-w]];
    iL=L.polygon(pts,{color:irisColor,weight:2,dashArray:'8,4',fillColor:irisColor,fillOpacity:.08})
      .bindTooltip('IRIS estimé',{direction:'top'}).addTo(map);
  }
  if(isCompare) irisLayer2=iL; else irisLayer=iL;
  const cbI=document.querySelector('.lcb[data-l="iris"]');
  if(cbI&&!cbI.checked)map.removeLayer(iL);

  // Rayon
  const rL=L.circle([lat,lng],{radius:rayon,color:pinColor,weight:1.5,dashArray:'6,4',fillColor:pinColor,fillOpacity:.04}).addTo(map);
  if(isCompare) rayonLayer2=rL; else rayonLayer=rL;
  const cbR=document.querySelector('.lcb[data-l="rayon"]');
  if(cbR&&!cbR.checked)map.removeLayer(rL);

  // POI réels via Overpass
  const activeKeys=Object.keys(POI_CFG).filter(k=>{const cb=document.querySelector(`.lcb[data-l="${k}"]`);return cb&&cb.checked});
  for(const key of activeKeys){
    const items=await fetchPOI(key,lat,lng,rayon);
    if(!items.length)continue;
    const g=L.layerGroup();
    items.slice(0,30).forEach(item=>{
      const tags=item.tags;
      let pop=`<b>${POI_CFG[key].e} ${item.name}</b>`;
      const addr=[tags['addr:housenumber'],tags['addr:street']].filter(Boolean).join(' ');
      if(addr)pop+=`<br><small>${addr}</small>`;
      const oh=tags.opening_hours;
      if(oh)pop+=`<br><small>🕐 ${oh}</small>`;
      if(tags.phone)pop+=`<br><small>📞 ${tags.phone}</small>`;
      L.marker([item.lat,item.lng],{icon:mkIcon(POI_CFG[key].e,POI_CFG[key].c)}).bindPopup(pop,{maxWidth:220}).addTo(g);
    });
    g.addTo(map);
    layerGroups[key+suffix]=g;
  }
}

