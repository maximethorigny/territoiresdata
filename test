async function enrichCommune(geo){
  if(!geo.codePostal)return geo;
  try{
    const url='https://geo.api.gouv.fr/communes?codePostal='+geo.codePostal+'&fields=code,nom,population,superficie&limit=5';
    const res=await fetch(url);if(!res.ok)return geo;
    const data=await res.json();if(!data||!data.length)return geo;
    let best=data[0];
    if(geo.commune){const m=data.find(x=>x.nom.toLowerCase()===geo.commune.toLowerCase());if(m)best=m;}
    geo.population=best.population||0;geo.superficie=best.superficie||0;
    geo.densite=geo.superficie>0?Math.round(geo.population/(geo.superficie/100)):0;
    geo.codeCommune=best.code;if(best.nom)geo.commune=best.nom;
  }catch(e){}
  return geo;
}

async function getIRIS(lat,lng,codeCommune){
  if(!codeCommune)return null;
  try{
    // Étape 1 : trouver le code IRIS du point
    const url1='https://geo.api.gouv.fr/iris?lon='+lng+'&lat='+lat+'&codeCommune='+codeCommune+'&fields=code,nom,type';
    const res1=await fetch(url1);
    if(!res1.ok)return null;
    const data1=await res1.json();
    if(!data1||!data1.length)return null;
    const irisCode=data1[0].code;
    const irisNom=data1[0].nom;

    // Étape 2 : récupérer le vrai polygone via l'API GeoJSON Etalab
    // Format: https://geo.api.gouv.fr/iris/{code}?fields=code,nom,contour
    const url2='https://geo.api.gouv.fr/iris/'+irisCode+'?fields=code,nom,contour';
    const res2=await fetch(url2);
    if(res2.ok){
      const d2=await res2.json();
      if(d2&&d2.contour&&d2.contour.coordinates&&d2.contour.coordinates.length){
        return{code:irisCode,nom:irisNom,contour:d2.contour,type:data1[0].type};
      }
    }

    // Étape 3 fallback : API découpage avec geometry
    const url3='https://geo.api.gouv.fr/communes/'+codeCommune+'/iris/'+irisCode+'?fields=code,nom,contour';
    try{
      const res3=await fetch(url3);
      if(res3.ok){
        const d3=await res3.json();
        if(d3&&d3.contour)return{code:irisCode,nom:irisNom,contour:d3.contour};
      }
    }catch(e3){}

    // Retourner au moins le code/nom sans contour
    return{code:irisCode,nom:irisNom,contour:null};
  }catch(e){return null}
}

